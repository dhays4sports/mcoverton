    "buying_home": {"label": "I’m buying a home.", "shoppingReason": "buying_home", "ownershipDuration": "buying_now", "evidenceOnlyAfterExplicitSelection": true},
    "nonrenewal_concern": {"label": "I have a nonrenewal concern.", "shoppingReason": "nonrenewal_concern", "evidenceOnlyAfterExplicitSelection": true},
    "coverage_concern": {"label": "I have a coverage question.", "shoppingReason": "something_else", "evidenceOnlyAfterExplicitSelection": true},
    "service_concern": {"label": "I want a different service experience.", "shoppingReason": "service_change", "evidenceOnlyAfterExplicitSelection": true},
    "bundle_review": {"label": "I want to review home and auto together.", "shoppingReason": "something_else", "bundleContext": "home_auto", "evidenceOnlyAfterExplicitSelection": true},
